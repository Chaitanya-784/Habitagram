<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bgimag"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Modern Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:elevation="10dp"
            android:layout_margin="12dp">

            <!-- Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👥 My Friends"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:layout_marginBottom="20dp" />

            <!-- Empty Message -->
            <TextView
                android:id="@+id/tvNoFriendsMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No friends added yet."
                android:textAlignment="center"
                android:gravity="center"
                android:textSize="16sp"
                android:textColor="#AAAAAA"
                android:visibility="gone"
                android:layout_marginTop="8dp" />

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMyFriends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp" />

            <ImageView
                android:id="@+id/ivFriendPhoto"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginTop="8dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_photo"
                android:contentDescription="Friend's Profile Photo" />

            <Button
                android:id="@+id/btnCaptureHabit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Capture Habit &amp; Send"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
