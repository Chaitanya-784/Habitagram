<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bgimag"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Modern Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp"
            android:elevation="10dp"
            android:layout_margin="12dp">

            <!-- Profile Section -->
            <LinearLayout
                android:id="@+id/profileSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="20dp">

                <!-- Circular Profile Image -->
                <de.hdodenhof.circleimageview.CircleImageView
                    android:id="@+id/imgProfile"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:src="@drawable/ic_user"
                    android:layout_marginEnd="16dp" />

                <!-- Profile Info -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Username: User"
                        android:textSize="18sp"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvFriendsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Friends: 5"
                        android:textSize="16sp"
                        android:textColor="#CCCCCC" />

                    <TextView
                        android:id="@+id/tvStreak"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Streak: 0 🔥"
                        android:textSize="16sp"
                        android:textColor="#CCCCCC" />

                    <ProgressBar
                        android:id="@+id/streakProgressBar"
                        android:layout_width="200dp"
                        android:layout_height="wrap_content"
                        android:max="100"
                        android:progress="0"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Greeting -->
            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👋 Hi, User!"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="20dp" />

            <!-- Stats -->
            <TextView
                android:id="@+id/tvHabitCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌 Habits added: 0"
                android:textColor="#DDDDDD"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvCompletedHabits"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅ Completed: 0"
                android:textColor="#DDDDDD"
                android:layout_marginBottom="20dp" />

            <!-- Habits by Date Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="📆 Habits by Date"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp" />

            <!-- Empty Message -->
            <TextView
                android:id="@+id/tvNoHabitsMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No habits added yet."
                android:textAlignment="center"
                android:gravity="center"
                android:textSize="16sp"
                android:textColor="#AAAAAA"
                android:visibility="gone"
                android:layout_marginTop="16dp" />

            <!-- RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvGroupedHabits"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
